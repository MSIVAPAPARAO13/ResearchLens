# ResearchLens Environment Configuration (Phase 16)
# Copy this file to .env and adjust variables as needed for your target environment.

# -----------------------------------------------------------------------------
# Runtime & Environment
# -----------------------------------------------------------------------------
RESEARCHLENS_ENV=production        # development, production, test
RESEARCHLENS_DEBUG=false           # false in production
RESEARCHLENS_SECRET_KEY=           # Optional API secret key for token authentication

# -----------------------------------------------------------------------------
# Model & Compute Configuration
# -----------------------------------------------------------------------------
RESEARCHLENS_MODEL_NAME=facebook/bart-large-cnn
RESEARCHLENS_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RESEARCHLENS_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
RESEARCHLENS_DEVICE=auto           # auto, cpu, cuda

# -----------------------------------------------------------------------------
# Ingestion & Context Windows
# -----------------------------------------------------------------------------
RESEARCHLENS_MAX_INPUT_TOKENS=1024
RESEARCHLENS_CHUNK_SIZE=900
RESEARCHLENS_CHUNK_OVERLAP=100
RESEARCHLENS_MAX_UPLOAD_SIZE_MB=50

# -----------------------------------------------------------------------------
# Retrieval & Reranking Parameters
# -----------------------------------------------------------------------------
RESEARCHLENS_VECTOR_STORE_TYPE=faiss
RESEARCHLENS_TOP_K=5
RESEARCHLENS_SIMILARITY_THRESHOLD=0.25
RESEARCHLENS_DENSE_CANDIDATE_K=10
RESEARCHLENS_BM25_CANDIDATE_K=10
RESEARCHLENS_RERANK_TOP_K=5
RESEARCHLENS_DENSE_WEIGHT=0.6
RESEARCHLENS_BM25_WEIGHT=0.4

# -----------------------------------------------------------------------------
# Persistence & Storage
# -----------------------------------------------------------------------------
RESEARCHLENS_WORKSPACES_DIR=data/workspaces

# -----------------------------------------------------------------------------
# MLOps & Experiment Tracking
# -----------------------------------------------------------------------------
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://localhost:5000  # Local tracking server or remote PostgreSQL/HTTP
# MLFLOW_TRACKING_USERNAME=                # Optional remote HTTP basic auth
# MLFLOW_TRACKING_PASSWORD=                # Optional remote HTTP basic auth
# MLFLOW_REGISTRY_URI=                     # Optional dedicated Model Registry URI (e.g. postgresql://...)

# -----------------------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------------------
RESEARCHLENS_LOG_LEVEL=INFO        # DEBUG, INFO, WARNING, ERROR, CRITICAL
RESEARCHLENS_LOG_FORMAT=text       # text or json
